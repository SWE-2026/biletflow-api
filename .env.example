# Copy to .env for a local or deployed demo. Values are read by docker compose.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
PUBLIC_WEB_URL=http://localhost:5173
ADMIN_EMAILS=admin@example.com
TRUST_PROXY=false

# Leave these empty for local development: the API logs outgoing messages and exposes OTP demo
# codes. Set all five values to send real demo emails through an SMTP sandbox/provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=BiletFlow Demo <no-reply@example.com>
